<%= render 'layouts/flash' %>
<div class="dark:text-white mt-2">
  <h1 class="text-2xl"><%= t(:settings) %></h1>
  <ul class="divide-y divide-gray-300 dark:divide-gray-700">
    <li class="pb-4">
      <% if !@user.exporting_job_applications %>
        <%= button_to @user.job_application_export.present? ? t(:reexport_job_applications) : t(:export_job_applications),
          export_job_applications_path,
          class: 'mt-6
                  rounded-md
                  px-3.5 py-1
                  bg-green-600
                  hover:bg-green-500
                  text-white
                  inline-block
                  font-medium
                  cursor-pointer'
        %>

        <% if @user.job_application_export.present? %>
          <%= link_to t(:download_job_applications),
            url_for(@user.job_application_export),
            class: 'mt-4
                    rounded-md
                    px-3.5 py-1
                    bg-blue-600
                    hover:bg-blue-500
                    text-white
                    inline-block
                    font-medium
                    cursor-pointer'
          %>
        <% end %>
      <% else %>
        <p class="mt-6">
          <%= t(:export_in_progress) %>
        </p>
      <% end %>
    </li>
    <li class="py-4">
      <%= link_to t(:resume),
          new_curriculum_vitae_path,
          class: "rounded-md
                  px-3.5 py-1
                  bg-green-600
                  hover:bg-green-500
                  text-white
                  inline-block
                  font-medium
                  cursor-pointer"
          %>
    </li>
  </ul>
</div>
