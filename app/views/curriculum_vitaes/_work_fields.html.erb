<div class="nested-fields">
  <ul>
    <li>
      <%= label_tag "name-#{index}", t(:name) %>
      <%= text_field_tag 'curriculum_vitae[resume][work][][name]',
                        '',
                        id: "name-#{index}",
                        class: 'shadow
                                appearance-none
                                border
                                border-blue-500
                                rounded
                                w-full
                                py-2
                                px-3
                                leading-tight
                                bg-inherit
                                focus:border-blue-700' %>
    </li>
    <li>
      <%= label_tag "position-#{index}", t(:position) %>
      <%= text_field_tag 'curriculum_vitae[resume][work][][position]',
                         '',
                         id: "position-#{index}",
                         class: 'shadow
                                 appearance-none
                                 border
                                 border-blue-500
                                 rounded
                                 w-full
                                 py-2
                                 px-3
                                 leading-tight
                                 bg-inherit
                                 focus:border-blue-700' %>
    </li>
  </ul>
  <button type="button"
          data-action="nested-json#remove"
          class="rounded-md
                 px-3.5 py-1 my-2
                 bg-red-600
                 hover:bg-red-500
                 text-white
                 inline-block
                 font-medium
                 cursor-pointer">
    <%= t(:remove) %>
  </button>
</div>
