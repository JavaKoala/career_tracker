<div class="nested-fields">
  <ul>
    <li>
      <%= label_tag "network-#{index}", t(:network) %>
      <%= text_field_tag 'curriculum_vitae[resume][basics][profiles][][network]',
                         '',
                         id: "network-#{index}",
                         class: 'shadow
                                 appearance-none
                                 border
                                 border-blue-500
                                 rounded
                                 w-full
                                 py-2
                                 px-3
                                 leading-tight
                                 bg-inherit
                                 focus:border-blue-700' %>
    </li>
    <li>
      <%= label_tag "username-#{index}", t(:username) %>
      <%= text_field_tag 'curriculum_vitae[resume][basics][profiles][][username]',
                         '',
                         id: "username-#{index}",
                         class: 'shadow
                                 appearance-none
                                 border
                                 border-blue-500
                                 rounded
                                 w-full
                                 py-2
                                 px-3
                                 leading-tight
                                 bg-inherit
                                 focus:border-blue-700' %>
    </li>
  </ul>
  <button type="button"
          data-action="nested-json#remove"
          class="rounded-md
                px-3.5 py-1 my-2
                bg-red-600
                hover:bg-red-500
                text-white
                inline-block
                font-medium
                cursor-pointer">
    <%= t(:remove) %>
  </button>
</div>
