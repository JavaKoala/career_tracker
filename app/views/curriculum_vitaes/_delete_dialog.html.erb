<div data-controller="dialog">
  <dialog
    data-dialog-target="dialog"
    aria-label="<%= t(:delete_resume) %>"
    class="w-full
           md:w-1/2
           self-center
           justify-self-center
           p-4
           m-auto
           rounded-lg
           shadow-xl
           border-2
           dark:bg-black
           dark:text-white
           border-blue-500">
    <%= render partial: 'layouts/dialog_components/header', locals: { title: t(:are_you_sure) } %>
    <%= render partial: 'layouts/form_components/delete_button',
               locals: { delete_path: curriculum_vitae_path, button_text: t(:delete_resume) }
    %>
  </dialog>

  <button
    type="button"
    data-action="dialog#open"
    class="rounded-md
           px-3.5 py-1
           bg-red-600
           hover:bg-red-500
           text-white
           inline-block
           font-medium
           cursor-pointer">
    <%= t(:delete_resume) %>
  </button>
</div>
